# =================================================================
# 1. SYSTEM, IDEs & LOGS
# =================================================================
.DS_Store
Thumbs.db
.history/
.gemini
.windsurf/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDEs
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# VS Code (Keep config, ignore runtime/internal data)
.vscode/
*.vscode/
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# =================================================================
# 2. FRONTEND (React, Angular, Vite, Node)
# =================================================================
node_modules/
**/node_modules/
dist/
**/dist/
.angular/
**/ .angular/
.vite/
.cache/
/tmp/
/out-tsc/

# =================================================================
# 3. BACKEND: PYTHON (Solus/FastAPI/UV)
# =================================================================
__pycache__/
**/__pycache__/
.venv/
**/venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.py[cod]
*$py.class
.coverage
htmlcov/
build/
*.egg-info/

# =================================================================
# 4. BACKEND: RUST (MDJ-Core)
# =================================================================
target/
**/target/
**/*.rs.bk
# Cargo.lock wird bei Applikationen meist eingecheckt, bei Libs nicht.

# =================================================================
# 5. DATA, EXCEL & SECRETS (Security!)
# =================================================================
# Excel Temporary Files (Windows/Office)
~$*.xlsx
~$*.xls
~$*.csv

# Secrets & Config
.env
.env.*
!.env.example

# Local Databases
*.sqlite3
*.db

# =================================================================
# 6. DOCKER & INFRASTRUCTURE
# =================================================================
.docker/
docker-compose.override.yml

# Ignore all files in these directories...
data/*
assets/*
Auto-Switch-Camera_v1_Takeyoh/*

# ...but do not ignore the .gitkeep file itself
!data/.gitkeep
!assets/.gitkeep
